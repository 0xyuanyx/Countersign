# 이름만 적는다. 실제 값은 맥 키체인(key-add)에 넣는다.
# 키는 signer 프로세스만 읽는다. 지갑 MCP 서버와 에이전트 코드는 읽지 않는다.

# signer 전용
OURYN_DEV_MNEMONIC=
OURYN_DEPLOYER_KEY=
# signer와 지갑 MCP가 공유하는 검증 티켓 HMAC 키 (32바이트 hex). 실행할 때마다 새로 만들어도 된다.
OURYN_TICKET_SECRET=
# signer 소켓 경로 (기본 ~/.ouryn/signer.sock)
OURYN_SIGNER_SOCKET=

# HSP (운영진 답 대기 중이라 설정값으로 둔다, PROJECT.md §9 #1·#2)
OURYN_HSP_MODE=mock
OURYN_HSP_MCP_URL=
OURYN_PAY_CHAIN_ID=
